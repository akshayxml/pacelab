# Which data source to use: "strava" or "intervals"
DATA_PROVIDER=intervals

# ---------- Intervals.icu (DATA_PROVIDER=intervals) ----------
# Get your API key at https://intervals.icu/settings (bottom of the page,
# "Developer Settings"). Connect Garmin in Intervals.icu settings so
# activities sync there automatically.
INTERVALS_API_KEY=
# Optional. "0" = the athlete that owns the API key.
INTERVALS_ATHLETE_ID=0

# ---------- Strava (DATA_PROVIDER=strava) ----------
# Create an app at https://www.strava.com/settings/api
# Set "Authorization Callback Domain" to: localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Must match the callback domain registered with Strava.
STRAVA_REDIRECT_URI=http://localhost:5173/api/auth/strava/callback

# ---------- App ----------
# Where to send the user after login/logout.
FRONTEND_URL=http://localhost:5173
PORT=4000
